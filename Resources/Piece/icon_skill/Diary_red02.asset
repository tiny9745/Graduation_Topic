  m_Script: {fileID: 11500000, guid: fa6fea84340fc6941aff9a80523f507c, type: 3}
  m_Name: Diary_red02
  m_EditorClassIdentifier: 
  iconID: 12
  iconImage: {fileID: 21300000, guid: 348de5951a48f4b47bbfa5f6789f3c77, type: 3}
  skill_title: 
  skill_content: "\u6295\u5C04\u7269\u5C04\u64CA\u5F8C\u5728\u78B0\u89F8\u5230\u7684\u6575\u4EBA\u5730\u4E0A\u7522\u751F\u50B7\u5BB3\u7BC4\u570D(5\u79D2)"
  diary_title: "\u96E8\u591C"
  diary_content: "\u4ECA\u591C\u5929\u6C23\u4E0D\u4F73\uFF0C\u7A97\u5916\u72C2\u98A8\u66B4\u96E8\uFF0C\u9583\u96FB\u96F7\u8072\u4E0D\u65B7\uFF0C\u5929\u7136\u7684\u767D\u566A\u97F3\u5C31\u662F\u4EE4\u4EBA\u5FC3\u66E0\u795E\u6021\u554A\uFF0C\u4E0D\u9700\u8981\u6234\u8457\u8033\u6A5F\u4E5F\u80FD\u807D\u898B\u5F9E\u56DB\u9762\u516B\u65B9\u7684\u96E8\u8072\uFF0C\u5F77\u5F7F\u6574\u500B\u4EBA\u88AB\u96E8\u6C34\u5305\u570D\u8D77\u4F86\uFF0C\u5BE6\u969B\u4E0A\u5247\u662F\u5F85\u5728\u6EAB\u6696\u7684\u5BA4\u5167\u88E1\u2026\u2026\u53EA\u53EF\u60DC\u5BA2\u5EF3\u88E1\u6B64\u6642\u6B64\u523B\u4E5F\u6B63\u5728\u72C2\u98A8\u66B4\u96E8\u3002 
    \u6211\u4E5F\u4E0D\u6562\u8A62\u554F\u7238\u5ABD\u80FD\u4E0D\u80FD\u8B93\u6211\u56DE\u53BB\u623F\u9593\uFF0C\u56E0\u70BA\u4ED6\u5011\u4F3C\u4E4E\u9084\u6C92\u7F75\u5920\u6211\uFF0C\u539F\u56E0\u6B63\u662F\u6211\u4ECA\u5929\u53BB\u88DC\u7FD2\u73ED\u6642\u9072\u5230\u4E86\u5341\u4E94\u5206\u9418\uFF0C\u8001\u5E2B\u5C31\u6253\u7D66\u5ABD\u5ABD\u6253\u5C0F\u5831\u544A\uFF0C\u5979\u77E5\u9053\u4E86\u975E\u5E38\u751F\u6C23\u3002 
    \u6211\u4E0D\u60F3\u8AAA\u662F\u56E0\u70BA\u6211\u8DD1\u53BB\u901B\u66F8\u5E97\u6C92\u6CE8\u610F\u6642\u523B\u8868\u800C\u932F\u904E\u516C\u8ECA\uFF0C\u7D50\u679C\u4F86\u4E0D\u53CA\u8D95\u4E0A\u88DC\u7FD2\u73ED\u7684\u4E0A\u8AB2\u6642\u9593\u3002 
    \u4F46\u6211\u4E5F\u4E0D\u60F3\u7DE8\u8B0A\u8A00\uFF0C\u514D\u5F97\u8B93\u4ED6\u5011\u66F4\u751F\u6C23\u3002\u53EF\u662F\u7238\u5ABD\u903C\u554F\u4E0D\u51FA\u4F86\u539F\u56E0\uFF0C\u9084\u662F\u61A4\u6012\u5F97\u5C0D\u6211\u7834\u53E3\u5927\u7F75\uFF0C\u7F75\u8AAA\u6211\u4E0D\u601D\u9032\u53D6\u3001\u8F9C\u8CA0\u4ED6\u5011\u7684\u64AB\u990A\u3002\u525B\u597D\u5916\u9762\u7684\u96F7\u96E8\u8072\u525B\u597D\u84CB\u904E\u4ED6\u5011\u7684\u6012\u7F75\u8072\uFF0C\u6240\u4EE5\u6211\u6709\u4E9B\u653E\u7A7A\u6C92\u4ED4\u7D30\u807D\uFF0C\u53EA\u662F\u9762\u7121\u8868\u60C5\u76EF\u8457\u4ED6\u5011\u626D\u66F2\u7684\u81C9\u9F90\u3002 
    \u562E\u562E\u53E8\u53E8\u4E86\u5927\u534A\u5C0F\u6642\u5F8C\uFF0C\u4ED6\u5011\u624D\u80AF\u653E\u6211\u8D70\u3002\u5509...\u2026\u6211\u672C\u4F86\u6253\u7B97\u5728\u4ECA\u665A\u95B1\u8B80\u65B0\u501F\u7684\u5C0F\u8AAA\uFF0C\u73FE\u5728\u5FC3\u60C5\u5168\u90E8\u6C92\u4E86\u3002"
  date: "4\u670811\u865F"
