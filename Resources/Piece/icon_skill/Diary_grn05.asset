  m_Script: {fileID: 11500000, guid: fa6fea84340fc6941aff9a80523f507c, type: 3}
  m_Name: Diary_grn05
  m_EditorClassIdentifier: 
  iconID: 5
  iconImage: {fileID: 0}
  skill_title: 
  skill_content: "\u88AB\u6575\u4EBA\u653B\u64CA\u5F8C\uFF0C\u4E0B\u4E00\u6B21\u653B\u64CA\u7684\u50B7\u5BB3\u63D0\u534750%"
  diary_title: "\u66F8\u7C64"
  diary_content: "\u770B\u5C0F\u8AAA\u6642\u6211\u6703\u96A8\u624B\u62FF\u5EE2\u7D19\u4F86\u7576\u4F5C\u81E8\u6642\u7684\u66F8\u7C64\uFF0C\u96D6\u7136\u919C\u4F46\u81F3\u5C11\u80FD\u7528\u3002\u4E0D\u904E\u6700\u8FD1\u5728\u7DB2\u8DEF\u4E0A\u770B\u5230\u88FD\u4F5C\u66F8\u7C64\u7684\u5F71\u7247\uFF0C\u7A81\u7136\u60F3\u8981\u597D\u770B\u7684\u66F8\u7C64\uFF0C\u800C\u4E14\u88FD\u4F5C\u65B9\u6CD5\u5176\u5BE6\u4E5F\u4E0D\u96E3\uFF0C\u6240\u4EE5\u6211\u8CB7\u4E86\u4E9B\u5F69\u7D19\u3001\u7DDE\u5E36\u548C\u4E7E\u71E5\u82B1\u6253\u7B97\u81EA\u5DF1\u52D5\u624B\u505A\u3002 
    \u7336\u8C6B\u4E86\u5F88\u4E45\u5230\u5E95\u8981\u88C1\u6210\u4EC0\u9EBC\u5F62\u72C0\uFF0C\u661F\u661F\uFF1F\u611B\u5FC3\uFF1F\u6216\u662F\u82B1\u6735\u9020\u578B\uFF1F\u6211\u5E0C\u671B\u5BE6\u7528\u81F3\u4E0A\uFF0C\u88C1\u6210\u9577\u65B9\u5F62\u7684\u9020\u578B\u6BD4\u8F03\u597D\u4F7F\u7528\u3002\u6211\u5728\u7C89\u7D05\u8272\u7684\u7D19\u5F35\u4E0A\u958B\u59CB\u9ECF\u6EFF\u4E7E\u71E5\u82B1\uFF0C\u85B0\u8863\u8349\u3001\u6EFF\u5929\u661F\u3001\u9084\u6709\u5C0F\u96DB\u83CA\u2026\u2026\u5C31\u7B97\u4E7E\u71E5\u5F8C\u4F9D\u7136\u4FDD\u6301\u8457\u7F8E\u9E97\u7684\u8272\u5F69\u3002 
    \u88FD\u4F5C\u904E\u7A0B\u5F88\u6709\u8DA3\uFF0C\u800C\u4E14\u4E00\u9EDE\u4E5F\u4E0D\u56F0\u96E3\u3002\u4E00\u5C64\u4E00\u5C64\u758A\u8D77\u4F86\u7684\u82B1\u6735\u8C50\u5BCC\u4E86\u756B\u9762\uFF0C\u5F77\u5F7F\u6574\u500B\u6625\u5929\u90FD\u6FC3\u7E2E\u5728\u9019\u5F35\u66F8\u7C64\u4E0A\u3002\u6211\u539F\u672C\u4EE5\u70BA\u4E82\u8CBC\u6703\u986F\u5F97\u96DC\u4E82\uFF0C\u7D50\u679C\u51FA\u4E4E\u610F\u6599\u7684\u597D\u770B\u3002 
    \u6700\u5F8C\u6211\u5728\u66F8\u7C64\u6700\u4E0A\u9762\u958B\u6D1E\uFF0C\u628A\u7DDE\u5E36\u7A7F\u4E86\u904E\u53BB\u6253\u500B\u8774\u8776\u7D50\uFF0C\u518D\u628A\u5B83\u88DD\u9032\u5851\u81A0\u5957\u88E1\u4F86\u4FDD\u8B77\uFF0C\u81EA\u88FD\u66F8\u7C64\u5C31\u5B8C\u6210\u4E86\uFF01\u6211\u628A\u593E\u5728\u5C0F\u8AAA\u88E1\u7684\u5EE2\u7D19\u66F8\u7C64\u8DDF\u65B0\u505A\u7684\u4E7E\u71E5\u82B1\u66F8\u7C64\u505A\u66FF\u63DB\uFF0C\u9019\u6A23\u6BCF\u6B21\u4E00\u7FFB\u958B\u66F8\uFF0C\u5FC3\u60C5\u5C31\u6703\u660E\u4EAE\u8D77\u4F86\u3002"
  date: "4\u670821\u865F"
