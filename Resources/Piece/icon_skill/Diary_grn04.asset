  m_Script: {fileID: 11500000, guid: fa6fea84340fc6941aff9a80523f507c, type: 3}
  m_Name: Diary_grn04
  m_EditorClassIdentifier: 
  iconID: 4
  iconImage: {fileID: 0}
  skill_title: 
  skill_content: "\u653B\u64CA\u529B1.5\u500D\uFF0C\u4F46\u53D7\u5230\u9020\u6210\u50B7\u5BB3\u768410%"
  diary_title: "\u5348\u9910"
  diary_content: "\u53EA\u8981\u60F3\u5230\u5176\u4ED6\u540C\u5B78\u5047\u65E5\u90FD\u80FD\u6109\u5FEB\u5730\u8DDF\u670B\u53CB\u51FA\u9580\u53BB\u73A9\uFF0C\u6211\u5C31\u89BA\u5F97\u597D\u7FA8\u6155\u554A\u3002\u7562\u7ADF\u6211\u4E5F\u6C92\u6709\u7279\u5225\u8981\u597D\u7684\u646F\u53CB\u53EF\u4EE5\u7D04\u51FA\u53BB\u73A9\uFF0C\u9051\u8AD6\u6211\u6109\u5FEB\u800C\u4E0D\u88AB\u7BA1\u5236\u7684\u6642\u5149\u4E5F\u50C5\u6709\u5468\u516D\u4E0A\u5348\uFF0C\u56E0\u70BA\u4E0B\u5348\u9084\u5F97\u53BB\u4E0A\u88DC\u7FD2\u73ED\uFF0C\u9031\u65E5\u5247\u662F\u6574\u5929\u7684\u88DC\u7FD2\u5730\u7344\uFF0C\u6839\u672C\u5C31\u6C92\u6709\u81EA\u5DF1\u7684\u9592\u6687\u6642\u5149\u3002 
    \u7238\u5ABD\u65E9\u65E9\u5C31\u51FA\u9580\u4E0A\u73ED\uFF0C\u6240\u4EE5\u6211\u7684\u5348\u9910\u5F97\u81EA\u5DF1\u8655\u7406\uFF0C\u901A\u5E38\u7238\u5ABD\u6703\u7559\u4E0B\u4E00\u9EDE\u5348\u9910\u9322\u8981\u6211\u81EA\u5DF1\u53BB\u9644\u8FD1\u9910\u5EF3\u89E3\u6C7A\u3002\u4E0D\u904E\u6211\u90FD\u6703\u628A\u4E00\u534A\u7684\u5348\u9910\u9322\u5077\u5077\u5B58\u8D77\u4F86\uFF0C\u9019\u6A23\u5C31\u80FD\u62FF\u53BB\u8CB7\u66F8\u4E86\uFF01\u525B\u597D\u6700\u8FD1\u6709\u4E00\u672C\u65B0\u51FA\u7684\u5C0F\u8AAA\u597D\u60F3\u8CB7\u4F86\u770B\u3002 
    \u7576\u7136\u4E5F\u4E0D\u662F\u8AAA\u6211\u5B8C\u5168\u4E0D\u5403\u5348\u9910\uFF0C\u53BB\u8CB7\u4E00\u4E9B\u4FBF\u5B9C\u7684\u6CE1\u9EB5\u4F86\u5403\u9084\u662F\u80FD\u586B\u98FD\u809A\u5B50\u3002\u958B\u6C34\u716E\u6EFE\u4E0B\u6CE1\u9EB5\uFF0C\u6DF7\u4E0A\u53C8\u751C\u53C8\u9E79\u7684\u8ABF\u5473\u6599\u52A0\u6D41\u5FC3\u53E3\u611F\u7684\u534A\u719F\u86CB\u5C31\u662F\u7F8E\u5473\u7684\u9B54\u6CD5\u3002 
    \u4F46\u7D55\u5C0D\u4E0D\u80FD\u88AB\u7238\u5ABD\u767C\u73FE\u6211\u5077\u5403\u6CE1\u9EB5\uFF0C\u56E0\u70BA\u4ED6\u5011\u7E3D\u8AAA\u300C\u5403\u6CE1\u9EB5\u6C92\u71DF\u990A\u3001\u6703\u5403\u58DE\u8EAB\u5B50\u300D\uFF0C\u6240\u4EE5\u6211\u4E5F\u53EA\u80FD\u79C1\u4E0B\u5077\u5077\u5403\u9019\u4E9B\u5783\u573E\u98DF\u7269\u3002\u53EA\u80FD\u8AAA\uFF0C\u8D8A\u5F97\u4E0D\u5230\u3001\u8D8A\u60F3\u8981\u3002"
  date: "3\u670827\u865F"
