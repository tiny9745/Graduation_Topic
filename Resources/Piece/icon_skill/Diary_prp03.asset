  m_Script: {fileID: 11500000, guid: fa6fea84340fc6941aff9a80523f507c, type: 3}
  m_Name: Diary_prp03
  m_EditorClassIdentifier: 
  iconID: 53
  iconImage: {fileID: 0}
  skill_title: 
  skill_content: "\u885D\u523A\u6642\u751F\u6210\u4E00\u500B\u6295\u64F2\u7269\u5C04\u5411\u6700\u8FD1\u7684\u6575\u4EBA"
  diary_title: "\u5931\u7720"
  diary_content: "\u6709\u6642\u5019\u8166\u4E2D\u7D0A\u4E82\u7684\u601D\u8003\u6703\u8B93\u6211\u8EBA\u5728\u5E8A\u4E0A\u8F3E\u8F49\u96E3\u7720\uFF0C\u9019\u6642\u5019\u6211\u6703\u4E7E\u8106\u8D77\u4F86\u5750\u5230\u7A97\u908A\uFF0C\u8A66\u5716\u5FD8\u8A18\u90A3\u4E9B\u6642\u5E38\u56F0\u64FE\u6211\u7684\u554F\u984C\u3002\u4F8B\u5982\u5728\u73ED\u4E0A\u6211\u5E7E\u4E4E\u6C92\u6709\u4E00\u500B\u80FD\u8AAA\u8A71\u7684\u670B\u53CB\uFF0C\u5728\u88DC\u7FD2\u73ED\u53C8\u89BA\u5F97\u5BEB\u4F5C\u696D\u597D\u96E3\uFF0C\u5728\u5BB6\u88E1\u53C8\u6703\u88AB\u7238\u5ABD\u7BA1\u6771\u7BA1\u897F\u2026\u2026\u9019\u4E9B\u58D3\u529B\u5C31\u50CF\u5DE8\u77F3\u822C\u8981\u5C07\u6211\u58D3\u6241\uFF0C\u4E00\u65E6\u60F3\u8D77\u9019\u4E9B\u4E8B\u60C5\uFF0C\u6211\u5C31\u7121\u6CD5\u505C\u6B62\u4E0D\u65B7\u806F\u60F3\u58DE\u4E8B\u7684\u601D\u7DD2\u706B\u8ECA\u3002 
    \u70BA\u4E86\u8F49\u79FB\u6CE8\u610F\u529B\uFF0C\u6211\u8A66\u5716\u89C0\u5BDF\u7A97\u5916\u4E00\u7247\u7121\u908A\u7121\u969B\u7684\u6DF1\u8272\u5929\u7A7A\u3002\u57CE\u5E02\u88E1\u7684\u5149\u5BB3\u7279\u5225\u56B4\u91CD\uFF0C\u8B93\u591C\u7A7A\u8B8A\u5F97\u7070\u6FDB\u6FDB\uFF0C\u5E7E\u4E4E\u770B\u4E0D\u6E05\u5149\u8292\uFF0C\u5230\u8655\u90FD\u662F\u9583\u720D\u7684\u9713\u8679\u71C8\u8DDF\u5435\u96DC\u7684\u8ECA\u6C34\u99AC\u9F8D\u3002\u4E0D\u904E\u5728\u51CC\u6668\u5169\u4E09\u9EDE\u6642\uFF0C\u4E00\u5207\u53C8\u6703\u56DE\u6B78\u5BC2\u975C\u3002 
    \u5B64\u55AE\u7684\u4E0D\u53EA\u6709\u6211\uFF0C\u9084\u6709\u5E7E\u4E4E\u8981\u88AB\u4EBA\u5DE5\u5149\u8292\u541E\u6C92\u7684\u661F\u661F\u3002\u6211\u5F97\u975E\u5E38\u4ED4\u7D30\u5730\u775C\u5927\u773C\u775B\uFF0C\u624D\u80FD\u5728\u9019\u7247\u7D14\u9ED1\u756B\u5E03\u4E0A\u627E\u5230\u4E00\u4E9B\u5FAE\u5C0F\u5149\u8292\u3002\u6211\u5E7E\u4E4E\u653E\u7A7A\uFF0C\u5C31\u9019\u9EBC\u76EF\u8457\u661F\u661F\u3002 
    \u6211\u559C\u6B61\u9019\u6A23\u975C\u5982\u7A7A\u57CE\u7684\u591C\u665A\uFF0C\u53EA\u807D\u5F97\u898B\u6211\u81EA\u5DF1\u5E73\u7A69\u7684\u5FC3\u8DF3\u8072\u3002\u53EF\u60DC\u71AC\u591C\u7684\u4EE3\u50F9\u5C31\u662F\u9694\u5929\u65E9\u4E0A\u5E7E\u4E4E\u6C92\u6709\u7761\u98FD\u7684\u611F\u89BA\uFF0C\u5728\u4E0A\u8AB2\u6642\u983B\u983B\u6253\u778C\u7761\u3002"
  date: "\u6708\u865F"
