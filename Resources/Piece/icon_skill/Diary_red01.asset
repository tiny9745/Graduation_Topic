  m_Script: {fileID: 11500000, guid: fa6fea84340fc6941aff9a80523f507c, type: 3}
  m_Name: Diary_red01
  m_EditorClassIdentifier: 
  iconID: 11
  iconImage: {fileID: 21300000, guid: efb08efa52125af4598eed10f89694e0, type: 3}
  skill_title: 
  skill_content: "\u6BCF10\u79D2\u751F\u6210\u4E00\u500B\u6295\u5C04\u7269"
  diary_title: "\u65B0\u8B80\u7684\u5C0F\u8AAA"
  diary_content: "\u65B0\u8B80\u4E86\u4E00\u672C\u53EB\u505A\u300A\u8594\u8587\u7684\u5973\u5152\u300B\u7684\u65B0\u66F8\uFF0C\u5167\u5BB9\u662F\u5973\u4E3B\u89D2\u88AB\u7236\u6BCD\u63A7\u5236\u6240\u6709\u751F\u6D3B\u7684\u4E00\u5207\u5927\u5C0F\u4E8B\uFF0C\u5B8C\u5168\u7121\u8996\u5979\u7684\u611F\u53D7\u3001\u9650\u5236\u4EBA\u8EAB\u81EA\u7531\uFF0C\u9019\u4E0D\u5C31\u8DDF\u6211\u7238\u5ABD\u4E00\u6A23\u561B\uFF01\u751A\u81F3\u7236\u6BCD\u9084\u8981\u5F37\u8FEB\u5973\u4E3B\u89D2\u7576\u796D\u54C1\uFF0C\u6839\u672C\u5C31\u6C92\u6709\u554F\u904E\u5973\u4E3B\u89D2\u7684\u610F\u9858\uFF01 
    \u96E3\u9053\u5168\u5929\u4E0B\u7684\u7236\u6BCD\u90FD\u8A8D\u70BA\u300C\u56E0\u70BA\u4F60\u662F\u6211\u751F\u990A\u7684\uFF0C\u6240\u4EE5\u4F60\u7684\u5C31\u662F\u6211\u7684\u300D\u55CE\uFF1F\u6709\u4E9B\u5730\u65B9\u6240\u63CF\u8FF0\u7684\u4EE3\u5165\u611F\u592A\u5F37\uFF0C\u770B\u4E86\u5F88\u6C23\u61A4\u3002 
    \u6545\u4E8B\u5F8C\u671F\u6C92\u60F3\u5230\u7A81\u7136\u4F86\u500B\u5927\u8F49\u6298\uFF0C\u51FA\u73FE\u4E86\u9ED1\u9B54\u6CD5\u5143\u7D20\uFF0C\u9084\u6709\u4EC0\u9EBC\u6050\u6016\u7684\u9ED1\u73AB\u7470\u5100\u5F0F\uFF01\uFF1F\u9019\u672C\u66F8\u5206\u985E\u5728\u300C\u89AA\u5B50\u95DC\u4FC2\u300D\u662F\u8AA4\u690D\u5427\uFF0C\u660E\u660E\u5C31\u662F\u300C\u61F8\u7591\u3001\u5947\u5E7B\u300D\u5C0F\u8AAA\uFF0C\u662F\u51FA\u7248\u793E\u641E\u932F\u4E86\u55CE\uFF1F 
    \u5973\u4E3B\u89D2\u767C\u73FE\u4E86\u7236\u6BCD\u9577\u5E74\u6276\u990A\u5979\u7684\u9670\u8B00\uFF0C\u53EA\u70BA\u4E86\u8981\u8B93\u5979\u6210\u70BA\u9ED1\u73AB\u7470\u5100\u5F0F\u7684\u796D\u54C1\uFF0C\u9019\u500B\u5100\u5F0F\u662F\u5BB6\u65CF\u7559\u4E0B\u4F86\u7684\u50B3\u7D71\uFF0C\u64DA\u8AAA\u80FD\u8CE6\u4E88\u53C3\u8207\u8005\u6C38\u6046\u751F\u547D\uFF0C\u53EA\u662F\u6BCF\u6B21\u90FD\u5FC5\u9808\u72A7\u7272\u4E00\u540D\u5973\u5152\u3002 
    \u4E3B\u89D2\u5F9E\u5730\u4E0B\u5BA4\u9003\u96E2\u6642\u7684\u6050\u61FC\u5F9E\u66F8\u88E1\u50B3\u67D3\u7D66\u6211\uFF0C\u5F77\u5F7F\u6211\u5C31\u662F\u9003\u8DD1\u7684\u5973\u5B69\u3002\u9003\u5230\u4E00\u534A\u9084\u662F\u88AB\u6293\u4E86\u56DE\u53BB\uFF0C\u771F\u662F\u592A\u7D55\u671B\u4E86\u2026\u2026\u6211\u505C\u6B62\u4E0D\u4E0B\u4F86\u7E7C\u7E8C\u95B1\u8B80\u7684\u6B32\u671B\u3002"
  date: "8\u670815\u865F"
