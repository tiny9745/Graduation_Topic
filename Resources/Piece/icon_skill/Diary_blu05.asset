  iconID: 25
  iconImage: {fileID: 21300000, guid: c3d7c9959021ed04cae059c4ce9fb5b8, type: 3}
  skill_title: "\u7159\u9727\u5F48"
  skill_content: "\u7206\u70B8\u5F8C\u8B93\u53D7\u5230\u7206\u70B8\u7BC4\u570D\u5F71\u97FF\u7684\u6575\u4EBA\u5C11\u91CF\u6263\u8840\uFF0C\u7DAD\u6301\u4E94\u79D2"
  diary_title: "\u97F3\u6A02\u8AB2"
  diary_content: "\u96D6\u7136\u6211\u4E0D\u7B97\u662F\u7279\u5225\u71B1\u611B\u97F3\u6A02\uFF0C\u4E0D\u904E\u5F9E\u5C0F\u5B78\u7FD2\u92FC\u7434\u6240\u4EE5\u770B\u5F97\u61C2\u6A02\u8B5C\uFF0C\u5728\u5B78\u6821\u97F3\u6A02\u8AB2\u4E0A\u7279\u5225\u5403\u9999\u3002\u7576\u5176\u4ED6\u540C\u5B78\u9084\u56F0\u60D1\u5730\u76EF\u8457\u97F3\u7B26\u4E00\u500B\u4E00\u500B\u5BEB\u97F3\u540D\u6216\u6307\u6CD5\uFF0C\u6211\u50C5\u6383\u4E00\u773C\u4FBF\u80FD\u770B\u61C2\uFF0C\u6211\u7684\u97F3\u6A02\u6210\u7E3E\u81EA\u7136\u4E5F\u6BD4\u5225\u4EBA\u597D\u3002\u6709\u6642\u5019\u8001\u5E2B\u6703\u7279\u5225\u53BB\u6307\u5C0E\u4E0D\u592A\u719F\u6089\u97F3\u7B26\u548C\u6307\u6CD5\u7684\u540C\u5B78\uFF0C\u653E\u4EFB\u6211\u548C\u5176\u4ED6\u6709\u97F3\u6A02\u57FA\u790E\u7684\u4EBA\u81EA\u7531\u7DF4\u7FD2\u3002 
    \u4E0D\u904E\u6709\u4E9B\u4EBA\u4F3C\u4E4E\u4E0D\u6EFF\u610F\u660E\u660E\u7E73\u4EA4\u540C\u6A23\u7684\u5B78\u8CBB\uFF0C\u8001\u5E2B\u537B\u53EA\u6559\u8DDF\u4E0D\u4E0A\u9032\u5EA6\u7684\u5B78\u751F\uFF0C\u597D\u50CF\u6709\u53BB\u8DDF\u6821\u65B9\u533F\u540D\u6297\u8B70\uFF0C\u8001\u5E2B\u6700\u8FD1\u4F3C\u4E4E\u5F88\u982D\u75BC\u3002\u56E0\u70BA\u6211\u4E5F\u4E0D\u5E0C\u671B\u8001\u5E2B\u7279\u5225\u95DC\u6CE8\u6211\uFF0C\u6240\u4EE5\u4E0D\u592A\u80FD\u7406\u89E3\u90A3\u4E9B\u8868\u9054\u6297\u8B70\u7684\u5B78\u751F\u5FC3\u601D\uFF0C\u4F46\u6211\u5F88\u7FA8\u6155\u4ED6\u5011\u6709\u52C7\u6C23\u8868\u9054\u81EA\u5DF1\u7684\u60F3\u6CD5\uFF0C\u7562\u7ADF\u4E0D\u662F\u6BCF\u500B\u4EBA\u90FD\u6562\u53BB\u722D\u53D6\u5C6C\u65BC\u81EA\u5DF1\u7684\u6B0A\u5229\u3002 
    \u81EA\u5DF1\u8B1B\u4E5F\u8A31\u6709\u9EDE\u81EA\u6200\u4E86\uFF0C\u4F46\u6211\u5728\u8AB2\u5802\u4E0A\u7684\u8868\u73FE\u4F3C\u4E4E\u5438\u5F15\u5230\u8001\u5E2B\u7684\u6CE8\u610F\uFF0C\u4ED6\u7279\u5225\u4F86\u8A62\u554F\u6211\u662F\u5426\u6709\u97F3\u6A02\u5E95\u5B50\u3002\u6211\u5982\u5BE6\u4EE5\u544A\uFF0C\u4ED6\u554F\u6211\u8981\u4E0D\u8981\u53BB\u53C3\u52A0\u5B78\u6821\u8209\u8FA6\u7684\u5C0F\u578B\u97F3\u6A02\u6703\uFF0C\u6211\u81EA\u7136\u4E0D\u60F3\uFF0C\u4E0D\u904E\u4ED6\u537B\u8DD1\u53BB\u8DDF\u7238\u5ABD\u8AAA\uFF0C\u7238\u5ABD\u4E5F\u7B54\u61C9\u8B93\u6211\u4E0A\u53F0\u3002\u6211\u73FE\u5728\u60F3\u62D2\u7D55\u4E5F\u7121\u6CD5\u4E86\uFF0C\u53EA\u597D\u52C9\u70BA\u5176\u96E3\u7684\u70BA\u4E86\u97F3\u6A02\u6703\u800C\u7A7A\u51FA\u66F4\u591A\u6642\u9593\u4F86\u7DF4\u7434\u3002"
  date: "4\u670819\u865F"
