  m_Script: {fileID: 11500000, guid: fa6fea84340fc6941aff9a80523f507c, type: 3}
  m_Name: Diary_prp05
  m_EditorClassIdentifier: 
  iconID: 35
  iconImage: {fileID: 0}
  skill_title: 35
  skill_content: "\u885D\u523A\u51B7\u537B\u6E1B\u5C11\u3001\u885D\u523A\u6642\u9593\u5FAE\u5E45\u589E\u52A0"
  diary_title: "\u65B0\u65E5\u8A18\u672C"
  diary_content: "\u6211\u5728\u66F8\u5C40\u60F3\u6311\u672C\u65B0\u7684\u65E5\u8A18\u672C\uFF0C\u4F46\u7A2E\u985E\u9078\u64C7\u5BE6\u5728\u662F\u592A\u591A\u4E86\uFF0C\u6211\u5728\u67B6\u5B50\u524D\u7AD9\u4E86\u597D\u4E45\uFF0C\u6700\u5F8C\u7BE9\u9078\u51FA\u4E86\u5169\u672C\u85CD\u8272\u7D20\u8272\u5C01\u9762\u548C\u7C89\u8272\u6709\u8457\u53EF\u611B\u8C93\u54AA\u5716\u6848\u5C01\u9762\u7684\u672C\u5B50\u3002\u96D6\u7136\u524D\u8005\u8A2D\u8A08\u5F88\u666E\u901A\uFF0C\u4F46\u6211\u89BA\u5F97\u9019\u5C31\u662F\u5927\u773E\u80FD\u63A5\u53D7\u7684\u6B3E\u5F0F\uFF0C\u7562\u7ADF\u53E6\u4E00\u672C\u5BE6\u5728\u592A\u83EF\u9E97\u4E86\uFF0C\u6703\u8CB7\u7684\u4EBA\u80AF\u5B9A\u6C92\u90A3\u9EBC\u591A\u3002 
    \u6211\u8E8A\u8E87\u4E86\u5F88\u4E45\uFF0C\u6700\u5F8C\u9084\u662F\u9078\u64C7\u4E86\u7C21\u7D04\u7684\u85CD\u8272\u65E5\u8A18\u672C\uFF0C\u96D6\u7136\u53E6\u4E00\u672C\u6211\u4E5F\u5F88\u60F3\u8CB7\uFF0C\u4F46\u662F\u4F4E\u8ABF\u7684\u5C01\u9762\u6BD4\u8F03\u4E0D\u6703\u5438\u5F15\u5230\u5225\u4EBA\u7684\u6CE8\u610F\u529B\uFF0C\u5927\u5BB6\u4E0D\u6703\u7279\u5225\u767C\u73FE\u9019\u65E5\u8A18\u672C\u88E1\u9762\u85CF\u6EFF\u4E86\u6211\u96E3\u4EE5\u8207\u4EBA\u8A34\u8AAA\u7684\u5FC3\u60C5\u3002\u5982\u679C\u88AB\u7238\u5ABD\u770B\u5230\u4E5F\u80FD\u8AAA\u9019\u662F\u4E0A\u8AB2\u7684\u7B46\u8A18\u672C\u800C\u8499\u6DF7\u904E\u53BB\u3002 
    \u6211\u62FF\u4E86\u65E5\u8A18\u672C\u8981\u53BB\u7D50\u5E33\uFF0C\u9019\u6642\u6709\u500B\u5C0F\u670B\u53CB\u4E0D\u65B7\u9B3C\u543C\u9B3C\u53EB\u7684\u5728\u5E97\u88E1\u8DD1\u4F86\u8DD1\u53BB\uFF0C\u4ED6\u649E\u5230\u67B6\u5B50\u5F8C\u53C8\u76F4\u63A5\u649E\u5230\u6211\uFF0C\u5BB3\u6211\u624B\u4E0A\u7684\u65E5\u8A18\u672C\u4E5F\u6389\u4E86\u4E0B\u53BB\u3002\u6211\u62FF\u8D77\u60F3\u8CB7\u7684\u65E5\u8A18\u672C\uFF0C\u767C\u73FE\u908A\u89D2\u537B\u88AB\u6298\u5230\u4E86\uFF0C\u6709\u4E9B\u4EBA\u5C31\u53EA\u8CB7\u559C\u6B61\u5B8C\u7F8E\u7121\u7F3A\u7684\u5546\u54C1\uFF0C\u4F46\u53D7\u50B7\u7684\u7269\u54C1\u537B\u7121\u4EBA\u554F\u6D25\u3002 
    \u4E0D\u904E\u6211\u9084\u662F\u53BB\u7D50\u5E33\u4E86\uFF0C\u5E97\u54E1\u4E5F\u6C92\u767C\u73FE\u9019\u9EDE\u7455\u75B5\uFF0C\u6211\u60F3\u5C0D\u5E97\u54E1\u4F86\u8AAA\u9019\u6839\u672C\u662F\u7121\u95DC\u7DCA\u8981\u7684\u4E8B\u60C5\u3002\u53EF\u662F\u9019\u500B\u50B7\u75D5\u537B\u6703\u8DDF\u8457\u9019\u672C\u65E5\u8A18\u4E00\u8F29\u5B50\u2026\u2026"
  date: "12\u67086\u865F"
