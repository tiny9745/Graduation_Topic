  iconID: 22
  iconImage: {fileID: 21300000, guid: 697d037538d71be4cab5990fbf4421e3, type: 3}
  skill_title: "\u53CD\u6297\u5FC3\u7406"
  skill_content: "\u56DE\u5FA9\u9020\u6210\u50B7\u5BB3\u768410%\u8840\u91CF\uFF0C\u4F46\u6301\u7E8C10\u79D2\u5167\u672A\u9020\u6210\u50B7\u5BB3\uFF0C
    \u5247\u6BCF5\u79D2\u6263\u8840\u6700\u5927\u8840\u91CF\u76845% "
  diary_title: "\u624B\u6307"
  diary_content: "\u4E0D\u77E5\u70BA\u4F55\uFF0C\u4ECA\u5929\u624B\u6307\u982D\u5728\u5F48\u7434\u7684\u6642\u5019\u611F\u5230\u5FAE\u5FAE\u7684\u75BC\u75DB\uFF0C\u5F77\u5F7F\u6709\u92B3\u5229\u7269\u5728\u523A\u6FC0\u8457\u808C\u8089\u3002 
    \u6211\u5FFD\u7136\u60F3\u8D77\u63A5\u66FF\u4E86\u4F55\u4E43\u8001\u5E2B\u7684\u92FC\u7434\u8001\u5E2B\uFF0C\u5979\u7684\u9577\u76F8\u4E00\u81C9\u56B4\u8085\uFF0C\u50CF\u7AE5\u8A71\u66F8\u88E1\u7684\u864E\u59D1\u5A46\uFF0C\u919C\u964B\u53C8\u90AA\u60E1\u3002 
    \u5728\u6211\u5F48\u932F\u4E00\u5169\u500B\u97F3\u7B26\u7684\u6642\u5019\uFF0C\u5979\u6703\u6BEB\u4E0D\u7559\u60C5\u5730\u62FF\u7B46\u6572\u6253\u6211\u7684\u6307\u7BC0\uFF0C\u800C\u4E14\u662F\u975E\u5E38\u7528\u529B\u4E14\u516C\u5E73\u7684\u6253\u4E86\u5341\u6839\u624B\u6307\uFF0C\u4E00\u96BB\u4E5F\u4E0D\u653E\u904E\uFF0C\u8B93\u4EBA\u75DB\u4E0D\u6B32\u751F\u3002\u5982\u679C\u6211\u6389\u773C\u6DDA\uFF0C\u90A3\u5979\u5C31\u6703\u6253\u66F4\u591A\u4E0B\uFF0C\u76F4\u5230\u90A3\u6BB5\u66F2\u5B50\u7262\u7262\u8A18\u5728\u6211\u8166\u6D77\u88E1\uFF0C\u80FD\u6D41\u66A2\u5730\u5F9E\u6211\u6307\u5C16\u5F48\u51FA\u4E0D\u843D\u62CD\u7684\u97F3\u6A02\uFF0C\u5979\u5F37\u8FEB\u8981\u6211\u8A8D\u771F\u4E00\u4E9B\uFF0C\u5426\u5247\u600E\u9EBC\u5C0D\u5F97\u8D77\u5979\u548C\u7236\u6BCD\u51FA\u7684\u9322\uFF0C\u53EF\u662F\u6211\u8A8D\u70BA\u6211\u7576\u6642\u5DF2\u7D93\u7AED\u76E1\u5168\u529B\u4E86\u3002 
    \u5982\u679C\u662F\u4F55\u4E43\u8001\u5E2B\u7684\u8A71\uFF0C\u5979\u4E00\u5B9A\u6703\u7B11\u8457\u64AB\u6478\u6211\u7684\u982D\uFF0C\u544A\u8A34\u6211\u5225\u6025\uFF0C\u518D\u6162\u6162\u5730\u5F48\u4E00\u6B21\u5C31\u6703\u66F4\u719F\u6089\u4E86\uFF0C\u5F48\u5F97\u597D\u9084\u6703\u8A87\u8B9A\u6211\u9032\u6B65\u8FC5\u901F\u3002\u771F\u662F\u5929\u5DEE\u5730\u5225\u7684\u6559\u80B2\u65B9\u5F0F\u3002 
    \u2026\u2026\u6211\u60F3\u662F\u6211\u7684\u8EAB\u9AD4\u8A18\u61B6\u9084\u5FD8\u4E0D\u53BB\u7576\u6642\u7684\u6050\u61FC\uFF0C\u6211\u63C9\u4E86\u63C9\u624B\u6307\uFF0C\u611F\u89BA\u6614\u65E5\u75BC\u75DB\u53C8\u56DE\u4F86\u4E86\uFF0C\u600E\u9EBC\u6A23\u4E5F\u7529\u4E0D\u958B\u60F1\u4EBA\u7684\u75DB\u82E6\u8A18\u61B6\u3002"
